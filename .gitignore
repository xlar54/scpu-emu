# Build directories
/build/
/out/
/dist/
/cmake-build-*/

# CMake and generated build-system files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile.user
compile_commands.json

# C/C++ compiler and linker output
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe
*.elf
*.axf
*.map
*.lst
*.d
*.su
*.gcda
*.gcno
*.gcov

# Raspberry Pi / bare-metal firmware output
*.bin
*.img
*.hex
*.uf2
*.dtb
*.dtbo
kernel*.img

# Generated test and diagnostic output
/Testing/
/test-results/
/coverage/
/logs/
/traces/generated/
*.log
*.trace
*.profraw
*.profdata

# Local ROM and cartridge images (do not commit copyrighted binaries)
/ROMs/*
!/ROMs/README.md
!/ROMs/manifest.example.json
!/ROMs/.gitkeep
*.rom
*.crt

# Local configuration and secrets
*.local
*.local.*
.env
.env.*
!.env.example

# Editor and IDE state. Shared VS Code settings are tracked so workspace fixes
# follow the repository; personal state under .vscode/ is not.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.idea/
.vs/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and backup files
*.tmp
*.temp
*.bak
*.orig
*.rej
.#*

# Local reference checkout; keep upstream RAD-Doom separate from project code
/_radclone/

# Raspberry Pi boot firmware. Freely redistributable, but 3MB of binary that is
# better fetched than vendored -- see Firmware/RaspberryPi/README.md.
/Firmware/RaspberryPi/*
!/Firmware/RaspberryPi/README.md
!/Firmware/RaspberryPi/config.txt

# Staged SD card contents, assembled by "make sdcard" from files already
# tracked or fetched elsewhere.
/SDCard/

# Downloaded build chain (toolchain + Circle) and upstream reference clones.
/_toolchain/
/_radmain/
Source/kernel8.img

# Local reference checkout of VICE, for its SCPU64 emulation.
/_vice/
/.tools/

# Local collaborator worktrees and copyrighted game/debug captures.
/.claude/
/CHT
/CHT.*
/C64Tests/WINTER GAMES.D64
/C64Tests/*.vsf
/C64Tests/wg_*.prg

# Test disk images are commercial software. Supply your own copies locally;
# same rule as /ROMs -- see ROMs/README.md.
#
# Excluding the contents rather than the directory itself: git cannot re-include
# a file whose parent directory is excluded, and the line below needs to work.
/C64Tests/diskimages/*

# Ours, not commercial -- the test disk built from C64Tests/asm by build.bat.
# Tracked so a fresh clone can run the suite without assembling it first.
!/C64Tests/diskimages/SCPU-TESTS.d81

# Profiling dumps. Regenerate them rather than tracking them; the histogram
# that justified the bank-0 inlining is preserved in commit 15cd5b7.
/hist.txt
*.hist

# Generated by Tools/mkiecdata.sh; deterministic, so no reason to track it.
/C64Tests/disk/TESTDATA.prg
